  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-tool-search"
  },
  "description": "Dynamic tool search and loading for Pi",
  "type": "module",
