{
  "name": "@cfcluan/pi-code-mode",
  "version": "0.3.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-code-mode"
  },
  "description": "Restricted JavaScript tool composition for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/sdk.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/pi-libtui/src/extension.ts"
    ],
    "image": "https://github.com/luan/agents/releases/download/v0.3.3/pi-code-mode.png",
    "video": "https://github.com/luan/agents/releases/download/v0.3.3/pi-code-mode.mp4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "pi-libtui": "workspace:*",
    "pi-xsettings": "workspace:*"
  },
  "bundledDependencies": [
    "pi-libtui",
    "pi-xsettings"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures \"$PWD/test\""
  }
}
