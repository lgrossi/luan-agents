  "dependencies": {
    "partial-json": "^0.1.7",
    "pi-libactions": "workspace:*",
    "pi-libtui": "workspace:*",
    "pi-code-mode": "workspace:*",
    "pi-xsettings": "workspace:*",
    "proxy-from-env": "^2.1.0",
    "undici": "^8.10.0"
