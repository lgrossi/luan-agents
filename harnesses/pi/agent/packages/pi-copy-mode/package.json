{
  "name": "pi-copy-mode",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-copy-mode"
  },
  "description": "Vim-style transcript selection, copying, annotations, and reactions for Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "copy-mode",
    "vim",
    "transcript",
    "annotations",
    "comments",
    "reactions"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./annotations": "./src/annotations/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/pi-libtui/src/extension.ts"
    ],
    "image": "https://github.com/luan/agents/releases/download/v0.3.0/pi-copy-mode.png",
    "video": "https://github.com/luan/agents/releases/download/v0.3.0/pi-copy-mode.mp4"
  },
  "dependencies": {
    "pi-libactions": "workspace:*",
    "pi-libtui": "workspace:*",
    "pi-xsettings": "workspace:*"
  },
  "bundledDependencies": [
    "pi-libactions",
    "pi-libtui",
    "pi-xsettings"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  }
}
