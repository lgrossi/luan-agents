{
  "name": "@luan-pi/pi-xsettings",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-xsettings"
  },
  "description": "Shared typed settings and settings UI for Pi extensions",
  "type": "module",
  "keywords": ["pi-package"],
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/sdk.ts"
  },
  "pi": {
    "extensions": ["./src/extension.ts", "./node_modules/@luan-pi/pi-libtui/src/extension.ts"]
  },
  "dependencies": {
    "@luan-pi/pi-libactions": "workspace:*",
    "@luan-pi/pi-libtui": "workspace:*",
    "smol-toml": "1.8.0",
    "typebox": "1.3.15"
  },
  "bundledDependencies": ["@luan-pi/pi-libactions", "@luan-pi/pi-libtui"],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  }
}
