{
  "name": "pi-fileops",
  "version": "0.3.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-fileops"
  },
  "description": "Native file operations for Pi, with structured apply_patch diffs",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/pi-libtui/src/extension.ts"
    ],
    "image": "https://github.com/luan/agents/releases/download/v0.3.2/pi-fileops.png",
    "video": "https://github.com/luan/agents/releases/download/v0.3.2/pi-fileops.mp4"
  },
  "dependencies": {
    "@cfcluan/pi-code-mode": "workspace:*",
    "pi-libtui": "workspace:*"
  },
  "bundledDependencies": [
    "@cfcluan/pi-code-mode",
    "pi-libtui"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  }
}
