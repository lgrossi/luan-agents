{
  "name": "pi-collapse",
  "version": "0.3.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luan/agents.git",
    "directory": "harnesses/pi/agent/packages/pi-collapse"
  },
  "description": "Collapse tool activity in Pi transcripts into expandable groups",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts",
      "./node_modules/pi-libtui/src/extension.ts"
    ],
    "image": "https://github.com/luan/agents/releases/download/v0.3.1/pi-collapse.png",
    "video": "https://github.com/luan/agents/releases/download/v0.3.1/pi-collapse.mp4"
  },
  "dependencies": {
    "pi-libtui": "workspace:*"
  },
  "bundledDependencies": [
    "pi-libtui"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test --only-failures test"
  }
}
