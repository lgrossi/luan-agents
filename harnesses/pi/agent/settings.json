{
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "packages": [
    "packages/pi-libtui",
    "packages/pi-transcript",
    "packages/pi-side-panel",
    "packages/pi-side-chat",
    "packages/pi-tuicr",
    "packages/pi-copy-mode",
    "packages/pi-annotations",
    "packages/pi-xsettings",
    "packages/pi-subagents",
    "packages/pi-developer-prompt",
    "packages/pi-codex-native",
    "packages/pi-skills",
    "packages/pi-code-mode",
    "packages/pi-exec-command",
    "packages/pi-apply-patch",
    "packages/pi-view-image",
    "packages/pi-tool-search",
    "packages/pi-custom-editor",
    "packages/pi-prompt-storage",
    {
      "source": "npm:@plannotator/pi-extension",
      "skills": []
    }
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "theme": "tokyo-night",
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "terminal": {
    "showTerminalProgress": true,
    "showImages": true
  },
  "steeringMode": "one-at-a-time",
  "quietStartup": false,
  "markdown": {
    "codeBlockIndent": "  ",
    "mermaid": "streaming"
  },
  "defaultTools": [],
  "showHardwareCursor": false,
  "branchSummary": {
    "skipPrompt": false
  },
  "editorPaddingX": 0,
  "outputPad": 1,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "enabledModels": [
    "anthropic/claude-fable-5-1",
    "openai/gpt-6-astra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra"
  ]
}
